# macOS
.DS_Store

# Xcode — user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Xcode — build output
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Generated project. Reproduce with `xcodegen generate` from Karaoke/.
# project.yml is the source of truth and IS committed.
Karaoke/Karaoke.xcodeproj/

# Python bytecode from the companion service
__pycache__/
*.pyc

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# Local configuration — never commit keys
Karaoke/Karaoke/Secrets.plist
*.local.xcconfig

# Spec Kit machine-local state
.specify/feature.json
.specify/extensions/*/local-config.yml
.specify/integrations/packages/
.specify/integrations/packages.json

# Agent tooling state
.omo/
.opencode/node_modules/

# Generated spike project
Tools/spikes/*/[A-Za-z]*.xcodeproj/

# Measurement recordings — large binaries, not source
specs/*.MP4
specs/*.mp4
specs/*.mov

# Designer concept mockups: low-resolution reference, kept out of the repo.
# They validated the information architecture; the UI is built from
# KaraokeTheme and native iOS conventions instead.
specs/karaoke_ui_concept_screens/
specs/karaoke_ui_concept_screens.zip
